        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make time for what’s next"
          }
        }
      }
    },
    "使用与网页版相同的账号。创建账号和找回密码会打开网页版；不勾选“记住我”时，会话仅在本次 App 运行期间保留，最长 12 小时。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用与网页版相同的账号。创建账号和找回密码会打开网页版；不勾选“记住我”时，会话仅在本次 App 运行期间保留，最长 12 小时。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your web account to sign in. Account creation and password recovery open the website. Without Remember me, your session lasts until the app closes, up to 12 hours."
          }
        }
      }
    },
