        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next opportunity.\nAll in hand."
          }
        }
      }
    },
    "为下一步留出时间": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为下一步留出时间"
