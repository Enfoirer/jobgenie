    "支持申请查看、新建与信息编辑，以及日程和邮箱概览。状态管理、邮箱授权、统计和推送将逐步加入。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持申请查看、新建与信息编辑，以及日程和邮箱概览。状态管理、邮箱授权、统计和推送将逐步加入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse, create, and edit applications, and view schedules and mailboxes. Status management, mailbox authorization, analytics, and push notifications are coming later."
          }
        }
      }
    },
